# Copy to .env, then run: pnpm setup:secrets --write
PUBLIC_HOST=tartgram.example.com
PUBLIC_URL=https://tartgram.example.com
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
DATA_DIR=./data
SPA_DIR=./apps/desktop/dist
ALLOW_INSECURE_LOCALHOST=false
TRUST_PROXY=false

# Default for new apps. Use instagram only with an existing eligible legacy app.
META_LOGIN_MODE=unified
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Omit OAUTH_REDIRECT_URI to derive PUBLIC_URL/oauth/instagram/callback.

# Generated locally by setup:secrets. Never commit .env or share these values.
META_VERIFY_TOKEN=
GATEWAY_CLIENT_TOKEN=
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_MS=28800000
DEDUPE_TTL_MS=600000
# Enable only after Meta grants Human Agent and only for manual support replies.
HUMAN_AGENT_ENABLED=false

# Required identity of the operator of your installation, used on legal pages.
OPERATOR_NAME=Your organization
OPERATOR_CONTACT_URL=https://example.com/contact
